---
// Clients.astro
---
<section id="clients" class="clients-section">
  <div class="clients-container">
    <div class="section-header">
      <div class="section-label">
        <span class="label-number">03 //</span>
        <span class="label-text">CLIENT SHOWCASE</span>
      </div>
      <h2 class="section-title">Featured Clients & Work</h2>
      <p class="section-subtitle">
        Empowering local businesses and organizations with high-performance web platforms and robust digital security.
      </p>
    </div>

    <div class="clients-grid">
      <!-- Featured Client: Toledo Circle Apartments -->
      <div class="client-card featured">
        <div class="card-glow"></div>
        <div class="card-border"></div>
        <div class="card-content">
          <div class="card-header">
            <div class="client-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              <span>RESIDENTIAL PROPERTY</span>
            </div>
            <span class="status-indicator">
              <span class="status-dot"></span> LIVE SITE
            </span>
          </div>

          <h3 class="client-name">Toledo Circle Apartments</h3>
          <p class="client-location">Toledo, Ohio // University of Toledo Area</p>
          <p class="client-desc">
            Custom web application and digital presence for a premier residential apartment community. Designed for optimal speed, mobile accessibility, interactive photo galleries, ADA compliance, and resident portal integration.
          </p>

          <div class="client-tech-stack">
            <span class="tech-tag">Web Design</span>
            <span class="tech-tag">Performance</span>
            <span class="tech-tag">ADA Accessibility</span>
            <span class="tech-tag">Resident Portal</span>
          </div>

          <div class="card-footer">
            <a href="https://toledocircleapartments.com" target="_blank" rel="noopener noreferrer" class="btn-client-link">
              <span>VISIT WEBSITE</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Prospective Client Callout Card -->
      <div class="client-card callout-card">
        <div class="card-glow"></div>
        <div class="card-border"></div>
        <div class="card-content">
          <div class="card-header">
            <div class="client-badge callout-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
              <span>YOUR PROJECT HERE</span>
            </div>
            <span class="status-indicator ready">
              <span class="status-dot"></span> ACCEPTING CLIENTS
            </span>
          </div>

          <h3 class="client-name">Ready to Upgrade Your Digital Infrastructure?</h3>
          <p class="client-location">Toledo, OH &amp; Remote Nationwide</p>
          <p class="client-desc">
            Whether you need a brand new high-speed website, custom web application, or a comprehensive cybersecurity audit, we build custom solutions tailored for your business.
          </p>

          <div class="client-tech-stack">
            <span class="tech-tag">Custom Development</span>
            <span class="tech-tag">Security Assessment</span>
            <span class="tech-tag">Penetration Testing</span>
          </div>

          <div class="card-footer">
            <a href="#contact" class="btn-client-link callout-link">
              <span>START A PROJECT</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .clients-section {
    position: relative;
    padding: 6rem 2rem;
    background-color: var(--bg-primary);
    border-top: 1px solid rgba(255, 255, 255, 0.03);
  }

  .clients-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem auto;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .label-number {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .label-text {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--text-muted);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .clients-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .client-card {
    position: relative;
    background: rgba(17, 19, 28, 0.6);
    border-radius: 12px;
    padding: 2.5rem;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .client-card.featured {
    background: rgba(24, 28, 40, 0.5);
    border-color: rgba(0, 210, 255, 0.2);
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at top right, rgba(0, 210, 255, 0.12), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .client-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(0, 210, 255, 0.15);
    border-color: rgba(0, 210, 255, 0.4);
  }

  .client-card:hover .card-glow {
    opacity: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .client-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background: rgba(0, 210, 255, 0.08);
    border: 1px solid rgba(0, 210, 255, 0.25);
    border-radius: 4px;
    color: var(--accent-blue);
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .client-badge.callout-badge {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--text-secondary);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent-blue);
    letter-spacing: 1px;
  }

  .status-indicator.ready {
    color: #4ade80;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
    box-shadow: 0 0 8px currentColor;
  }

  .client-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .client-location {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--accent-blue);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .client-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .client-tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tech-tag {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .btn-client-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.4rem;
    background: transparent;
    border: 1px solid var(--accent-blue);
    border-radius: 4px;
    color: var(--accent-blue);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .btn-client-link:hover {
    background: var(--accent-blue);
    color: #060814;
    box-shadow: 0 0 15px rgba(0, 210, 255, 0.4);
    transform: translateY(-2px);
  }

  .btn-client-link.callout-link {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-primary);
  }

  .btn-client-link.callout-link:hover {
    background: #fff;
    color: #060814;
    border-color: #fff;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 768px) {
    .clients-section {
      padding: 4rem 1.25rem;
    }

    .section-title {
      font-size: 2rem;
    }
  }
</style>
