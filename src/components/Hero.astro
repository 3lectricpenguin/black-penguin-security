---
// Hero.astro
---
<section class="hero-section">
  <!-- Subtle Background Grid & Glow -->
  <div class="hero-bg-grid"></div>
  <div class="hero-bg-glow"></div>

  <div class="hero-container">
    <div class="hero-content">
      <div class="status-indicator">
        <span class="status-dot"></span>
        <span class="status-text">TOLEDO, OH • WEB DESIGN &amp; IT SECURITY</span>
      </div>
      
      <h1 class="hero-title">
        High-Speed Websites &amp; Proactive <span class="text-gradient">IT Security</span>
      </h1>
      
      <p class="hero-description">
        We build fast, secure websites and provide dependable IT protection tailored for Toledo small businesses. Turn visitors into loyal customers with modern web design built for growth.
      </p>

      <div class="hero-buttons">
        <a href="#contact" class="btn-primary">
          <span>Get a Free Consultation</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#clients" class="btn-secondary">
          <span>View Featured Work</span>
        </a>
      </div>

      <div class="hero-features">
        <div class="hero-feat-item">
          <span class="feat-val">100%</span>
          <span class="feat-lbl">Page Speed Focus</span>
        </div>
        <div class="hero-feat-item">
          <span class="feat-val">&lt; 1s</span>
          <span class="feat-lbl">Target Load Time</span>
        </div>
        <div class="hero-feat-item">
          <span class="feat-val">Local</span>
          <span class="feat-lbl">Toledo, OH Support</span>
        </div>
      </div>
    </div>

    <!-- Modern Performance Showcase Card -->
    <div class="hero-visual">
      <div class="showcase-card">
        <div class="showcase-header">
          <div class="showcase-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <div class="showcase-url">electricpenguin.com/status</div>
          <span class="status-pill">LIVE</span>
        </div>

        <div class="showcase-body">
          <div class="metric-card score-card">
            <div class="score-ring">
              <svg viewBox="0 0 36 36" class="circular-chart blue">
                <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                <path class="circle" stroke-dasharray="99, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                <text x="18" y="20.35" class="percentage">99</text>
              </svg>
            </div>
            <div class="metric-info">
              <span class="metric-title">Performance Score</span>
              <span class="metric-sub">Google Lighthouse Standard</span>
            </div>
          </div>

          <div class="status-rows">
            <div class="status-row">
              <div class="row-icon check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="row-text">
                <span class="row-title">SSL Encryption &amp; Security</span>
                <span class="row-desc">256-Bit TLS Active</span>
              </div>
              <span class="row-badge">Verified</span>
            </div>

            <div class="status-row">
              <div class="row-icon check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="row-text">
                <span class="row-title">Mobile Responsive Design</span>
                <span class="row-desc">All Screen Sizes Supported</span>
              </div>
              <span class="row-badge">Optimized</span>
            </div>

            <div class="status-row">
              <div class="row-icon check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="row-text">
                <span class="row-title">Local SEO Structure</span>
                <span class="row-desc">Schema &amp; Meta Pre-Configured</span>
              </div>
              <span class="row-badge">Ready</span>
            </div>
          </div>
        </div>

        <div class="showcase-footer">
          <span>Engineered for Toledo Businesses</span>
          <span class="footer-badge">Electric Penguin</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 6rem 2rem 5rem 2rem;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--bg-primary);
  }

  .hero-bg-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(circle at 60% 40%, black, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 60% 40%, black, transparent 80%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-bg-glow {
    position: absolute;
    top: 20%;
    right: 15%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 20px;
    margin-bottom: 1.75rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-blue);
    box-shadow: 0 0 10px var(--accent-blue);
  }

  .status-text {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--accent-light);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .text-gradient {
    background: linear-gradient(135deg, #ffffff 30%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
    max-width: 580px;
  }

  .hero-buttons {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
    flex-wrap: wrap;
  }

  /* Primary Button */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.9rem 1.8rem;
    background: var(--accent-blue);
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 8px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
  }

  .btn-primary:hover {
    background: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
  }

  /* Secondary Button */
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.8rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.25s ease;
  }

  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  .hero-features {
    display: flex;
    gap: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
    width: 100%;
  }

  .hero-feat-item {
    display: flex;
    flex-direction: column;
  }

  .feat-val {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .feat-lbl {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 4px;
  }

  /* Showcase Card Styling */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .showcase-card {
    width: 100%;
    max-width: 440px;
    background: var(--bg-secondary);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(59, 130, 246, 0.1);
    overflow: hidden;
  }

  .showcase-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .showcase-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot.red { background: #ef4444; }
  .dot.yellow { background: #f59e0b; }
  .dot.green { background: #10b981; }

  .showcase-url {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.25);
    padding: 0.2rem 0.75rem;
    border-radius: 4px;
  }

  .status-pill {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .showcase-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .score-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem;
    background: rgba(31, 41, 55, 0.5);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 10px;
  }

  .score-ring {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .circular-chart {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .circle-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.08);
    stroke-width: 3.5;
  }

  .circle {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke: var(--accent-blue);
  }

  .percentage {
    fill: var(--text-primary);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.65rem;
    text-anchor: middle;
  }

  .metric-info {
    display: flex;
    flex-direction: column;
  }

  .metric-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .metric-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .status-rows {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.4);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .row-icon.check {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .row-text {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .row-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .row-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .row-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent-light);
    background: rgba(59, 130, 246, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .showcase-footer {
    padding: 0.85rem 1.25rem;
    background: rgba(15, 23, 42, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .footer-badge {
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Responsive breakpoints */
  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }
    
    .hero-content {
      align-items: center;
    }
    
    .hero-buttons {
      justify-content: center;
    }
    
    .hero-features {
      justify-content: center;
    }
  }

  @media (max-width: 576px) {
    .hero-title {
      font-size: 2.3rem;
    }
    
    .hero-features {
      flex-direction: column;
      gap: 1.25rem;
    }
  }
</style>
