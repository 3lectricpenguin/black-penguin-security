---
// TechConsole.astro
---
<section id="console" class="console-section">
  <div class="console-container">
    <div class="console-header">
      <div class="section-label">
        <span class="label-text">INTERACTIVE DEMO</span>
      </div>
      <h2 class="section-title">Website &amp; Security Diagnostics</h2>
      <p class="section-subtitle">
        Try our interactive diagnostic terminal. Run real-time checks on website performance, security headers, and system health.
      </p>
    </div>

    <!-- Terminal Window -->
    <div class="terminal-window">
      <!-- Terminal Title Bar -->
      <div class="terminal-bar">
        <div class="window-buttons">
          <span class="win-btn close"></span>
          <span class="win-btn minimize"></span>
          <span class="win-btn maximize"></span>
        </div>
        <div class="terminal-title">diagnostics@electricpenguin:~</div>
        <div class="terminal-status">SYSTEM STATUS: OK</div>
      </div>
      
      <!-- Terminal Screen -->
      <div class="terminal-screen" id="terminal-screen">
        <div class="terminal-log">
          <div class="log-line system-welcome">ELECTRIC PENGUIN IT SECURITY — SYSTEM DIAGNOSTICS [v2.4]</div>
          <div class="log-line system-welcome">© {new Date().getFullYear()} Electric Penguin IT Security. Professional Web &amp; Security Solutions.</div>
          <div class="log-line system-welcome">Type <span class="cmd-highlight">help</span> for available diagnostic commands.</div>
          <br />
        </div>
        
        <!-- Terminal Input Line -->
        <div class="terminal-input-line">
          <span class="terminal-prompt">diagnostics@electricpenguin:~$</span>
          <input type="text" id="terminal-input" autocomplete="off" spellcheck="false" maxlength="40" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const termInput = document.getElementById('terminal-input') as HTMLInputElement | null;
  const termScreen = document.getElementById('terminal-screen');
  const termLog = document.querySelector('.terminal-log');

  const COMMAND_LIST = {
    help: 'Available diagnostic commands: help, about, audit, status, speed, clear',
    about: 'Electric Penguin IT Security: Modern web design, high-speed development, and proactive security solutions for Toledo small businesses.',
    status: 'System Status: All services operational • SSL 256-Bit TLS Active • Uptime 99.9%',
    clear: '',
  };

  if (termInput && termScreen && termLog) {
    termScreen.addEventListener('click', () => {
      termInput.focus();
    });

    termInput.addEventListener('keydown', async (e) => {
      if (e.key === 'Enter') {
        const inputVal = termInput.value.trim();
        const cmd = inputVal.toLowerCase();
        
        appendLog(`diagnostics@electricpenguin:~$ ${inputVal}`, 'user-cmd');
        termInput.value = '';

        if (cmd === '') return;

        if (cmd === 'clear') {
          termLog.innerHTML = '';
        } else if (cmd === 'help') {
          appendLog(COMMAND_LIST.help, 'sys-out');
        } else if (cmd === 'about') {
          appendLog(COMMAND_LIST.about, 'sys-out');
        } else if (cmd === 'status') {
          appendLog(COMMAND_LIST.status, 'sys-out');
        } else if (cmd === 'audit' || cmd === 'scan') {
          termInput.disabled = true;
          await simulateAudit();
          termInput.disabled = false;
          termInput.focus();
        } else if (cmd === 'speed') {
          termInput.disabled = true;
          await simulateSpeed();
          termInput.disabled = false;
          termInput.focus();
        } else {
          appendLog(`Unknown command: "${inputVal}". Type "help" for instructions.`, 'sys-error');
        }

        termScreen.scrollTop = termScreen.scrollHeight;
      }
    });

    function appendLog(text: string, className: string = '') {
      if (!termLog) return;
      const line = document.createElement('div');
      line.className = `log-line ${className}`;
      line.innerHTML = text;
      termLog.appendChild(line);
      if (termScreen) {
        termScreen.scrollTop = termScreen.scrollHeight;
      }
    }

    function sleep(ms: number) {
      return new Promise(resolve => setTimeout(resolve, ms));
    }

    async function simulateAudit() {
      appendLog('Running website security and performance audit...', 'sys-loader');
      await sleep(500);
      appendLog('1. Verifying SSL/TLS encryption certificate... [ 256-BIT OK ]', 'sys-info');
      await sleep(400);
      appendLog('2. Checking security headers (HSTS, CSP, X-Frame)... [ SECURE ]', 'sys-info');
      await sleep(400);
      appendLog('3. Testing mobile responsiveness & layout bounds... [ OPTIMIZED ]', 'sys-info');
      await sleep(500);
      appendLog('4. Measuring Google Lighthouse performance metrics... [ 99/100 ]', 'sys-info');
      await sleep(500);
      appendLog('✔ Audit complete. Your site health is at 100%.', 'sys-success');
    }

    async function simulateSpeed() {
      appendLog('Measuring page load latency...', 'sys-loader');
      await sleep(400);
      appendLog('Server Response Time (TTFB): 48ms', 'sys-info');
      await sleep(300);
      appendLog('Asset Compression (Gzip/Brotli): ACTIVE', 'sys-info');
      await sleep(300);
      appendLog('First Contentful Paint (FCP): 0.4s', 'sys-info');
      await sleep(400);
      appendLog('✔ Speed target achieved. Page loads in under 1 second.', 'sys-success');
    }
  }
</script>

<style>
  .console-section {
    position: relative;
    padding: 6rem 2rem;
    background-color: var(--bg-primary);
  }

  .console-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .console-header {
    margin-bottom: 3.5rem;
    max-width: 650px;
  }

  .section-label {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .label-text {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-light);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Terminal CSS wrapper */
  .terminal-window {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  .terminal-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #1e293b;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.75rem 1.25rem;
    user-select: none;
  }

  .window-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .win-btn {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }

  .win-btn.close { background-color: #ef4444; }
  .win-btn.minimize { background-color: #f59e0b; }
  .win-btn.maximize { background-color: #10b981; }

  .terminal-title {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .terminal-status {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .terminal-screen {
    height: 360px;
    padding: 1.5rem;
    overflow-y: auto;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    color: #cbd5e1;
    line-height: 1.6;
    background: #090d16;
  }

  .terminal-screen::-webkit-scrollbar {
    width: 6px;
  }
  .terminal-screen::-webkit-scrollbar-track {
    background: transparent;
  }
  .terminal-screen::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
  }

  .log-line {
    margin-bottom: 0.4rem;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .system-welcome {
    color: var(--text-muted);
  }

  .cmd-highlight {
    color: var(--accent-light);
    font-weight: bold;
  }

  .user-cmd {
    color: #ffffff;
    font-weight: 600;
  }

  .sys-out, .sys-info {
    color: #94a3b8;
  }

  .sys-loader {
    color: var(--accent-light);
  }

  .sys-success {
    color: #38bdf8;
    font-weight: 600;
  }

  .sys-error {
    color: #f87171;
  }

  .terminal-input-line {
    display: flex;
    align-items: center;
  }

  .terminal-prompt {
    color: var(--accent-light);
    margin-right: 0.6rem;
    font-weight: bold;
  }

  #terminal-input {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-family: inherit;
    font-size: inherit;
    padding: 0;
    margin: 0;
    flex-grow: 1;
    caret-color: var(--accent-light);
  }

  @media (max-width: 768px) {
    .console-section {
      padding: 4rem 1.25rem;
    }

    .terminal-screen {
      height: 300px;
      padding: 1rem;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .terminal-status {
      display: none;
    }

    .section-title {
      font-size: 1.85rem;
    }
  }
</style>
