---
// Footer.astro
---
<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand">
        <div class="brand-logo">
          <svg viewBox="0 0 100 100" class="brand-svg" xmlns="http://www.w3.org/2000/svg">
            <polygon points="50,5 90,25 90,75 50,95 10,75 10,25" stroke="var(--accent-blue)" stroke-width="6" stroke-linejoin="round" fill="rgba(15,23,42,0.6)"/>
            <path d="M50,20 L75,45 L75,75 L50,90 L25,75 L25,45 Z" fill="none" stroke="#ffffff" stroke-width="4" stroke-linejoin="round"/>
            <path d="M50,50 L65,70 L50,85 L35,70 Z" fill="rgba(59, 130, 246, 0.15)" stroke="var(--accent-blue)" stroke-width="3" stroke-linejoin="round"/>
            <polygon points="50,42 55,33 45,33" fill="var(--accent-blue)"/>
            <circle cx="40" cy="27" r="2.5" fill="#ffffff"/>
            <circle cx="60" cy="27" r="2.5" fill="#ffffff"/>
          </svg>
          <span class="brand-name">ELECTRIC PENGUIN <span class="brand-highlight">IT SECURITY</span></span>
        </div>
        <p class="brand-desc">
          Professional web design, custom website development, and proactive IT security for small businesses in Toledo, OH.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="footer-links">
        <h4 class="footer-title">QUICK LINKS</h4>
        <ul class="links-list">
          <li><a href="/#services">Web Design &amp; Services</a></li>
          <li><a href="/#clients">Featured Work &amp; Clients</a></li>
          <li><a href="/#console">Interactive Diagnostics Demo</a></li>
          <li><a href="/#contact">Contact &amp; Quotes</a></li>
        </ul>
      </div>

      <!-- Quality Standards -->
      <div class="footer-methodology">
        <h4 class="footer-title">QUALITY &amp; TRUST STANDARDS</h4>
        <div class="standards-grid">
          <span class="standard-badge">LIGHTHOUSE 100%</span>
          <span class="standard-badge">256-BIT TLS SSL</span>
          <span class="standard-badge">ADA COMPLIANT</span>
          <span class="standard-badge">LOCAL TOLEDO TEAM</span>
        </div>
      </div>
    </div>

    <!-- Bottom copyright / Status -->
    <div class="footer-bottom">
      <div class="copyright">
        &copy; {new Date().getFullYear()} Electric Penguin IT Security. Built for Toledo Small Businesses.
      </div>
      <div class="network-status">
        <span class="status-indicator-pulse"></span>
        <span>TOLEDO, OH OFFICE • ONLINE SUPPORT</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: var(--bg-primary);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4.5rem 2rem 2.5rem 2rem;
    overflow: hidden;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr;
    gap: 4rem;
    margin-bottom: 3.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .brand-svg {
    width: 32px;
    height: 32px;
    padding: 2px;
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 6px;
    background: rgba(17, 24, 39, 0.8);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: var(--text-primary);
  }

  .brand-highlight {
    color: var(--accent-light);
    font-size: 0.9rem;
    letter-spacing: 0.5px;
  }

  .brand-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 340px;
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 24px;
    height: 2px;
    background: var(--accent-blue);
    border-radius: 2px;
  }

  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .links-list a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.25s ease;
  }

  .links-list a:hover {
    color: var(--accent-light);
    transform: translateX(3px);
    display: inline-block;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  .standard-badge {
    background: rgba(31, 41, 55, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 0.5rem 0.65rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    text-align: center;
    letter-spacing: 0.5px;
    transition: all 0.25s ease;
  }

  .standard-badge:hover {
    border-color: rgba(59, 130, 246, 0.3);
    color: var(--accent-light);
    background: rgba(59, 130, 246, 0.1);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .network-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .status-indicator-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .footer-bottom {
      flex-direction: column;
      gap: 1.25rem;
      text-align: center;
    }
  }
</style>
