---
// Services.astro
---
<section id="services" class="services-section">
  <div class="services-container">
    <div class="section-header">
      <div class="section-label">
        <span class="label-text">OUR SERVICES</span>
      </div>
      <h2 class="section-title">Complete Digital &amp; IT Solutions</h2>
      <p class="section-subtitle">
        We help Toledo small businesses succeed online with custom web development, proactive security assessments, and reliable IT support.
      </p>
    </div>

    <div class="services-grid">
      <!-- Service Card 1 -->
      <div class="service-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-header">
            <div class="service-icon">
              <!-- Web Design Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <span class="service-tag">DESIGN &amp; DEV</span>
          </div>

          <h3 class="service-name">Custom Web Design</h3>
          <p class="service-desc">
            Modern, mobile-responsive websites built for speed and conversions. Designed to attract local customers, rank higher on search engines, and reflect your brand's professionalism.
          </p>

          <ul class="service-features">
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Modern Astro &amp; React Engineering
            </li>
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Content Management &amp; Easy Updates
            </li>
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              High-Speed Page Load Optimization
            </li>
          </ul>
        </div>
      </div>

      <!-- Service Card 2 -->
      <div class="service-card active">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-header">
            <div class="service-icon">
              <!-- Security Shield Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <span class="service-tag">CYBERSECURITY</span>
          </div>

          <h3 class="service-name">Website &amp; Data Security</h3>
          <p class="service-desc">
            Proactive security audits and threat prevention. We protect your business and customer data against malware, data breaches, and service interruptions.
          </p>

          <ul class="service-features">
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Vulnerability Assessment &amp; Audits
            </li>
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              SSL/TLS Hardening &amp; Firewall Setup
            </li>
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Security Best Practices &amp; Compliance
            </li>
          </ul>
        </div>
      </div>

      <!-- Service Card 3 -->
      <div class="service-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-header">
            <div class="service-icon">
              <!-- IT Management Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                <line x1="6" y1="6" x2="6.01" y2="6"></line>
                <line x1="6" y1="18" x2="6.01" y2="18"></line>
              </svg>
            </div>
            <span class="service-tag">IT CONSULTING</span>
          </div>

          <h3 class="service-name">Managed IT Support</h3>
          <p class="service-desc">
            Dependable technical guidance, fast cloud hosting setup, and ongoing website maintenance so your digital systems run smoothly without unexpected downtime.
          </p>

          <ul class="service-features">
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Secure Cloud Hosting &amp; Domain Setup
            </li>
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Automated Backups &amp; Software Updates
            </li>
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Dedicated Local Technical Support
            </li>
          </ul>
        </div>
      </div>

      <!-- Service Card 4 -->
      <div class="service-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-header">
            <div class="service-icon">
              <!-- Search & Performance Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <span class="service-tag">LOCAL SEO</span>
          </div>

          <h3 class="service-name">SEO &amp; Optimization</h3>
          <p class="service-desc">
            Ensure your business stands out locally with search-optimized architecture, fast page load speeds, and full ADA accessibility across all devices.
          </p>

          <ul class="service-features">
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Local Search &amp; Schema Metadata
            </li>
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Full ADA Accessibility Compliance
            </li>
            <li>
              <svg class="feat-check" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Analytics &amp; Conversion Tracking
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    padding: 6rem 2rem;
    background-color: var(--bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .services-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3.5rem;
    max-width: 650px;
  }

  .section-label {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .label-text {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-light);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Grid configuration */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  /* Modern cards */
  .service-card {
    position: relative;
    background: rgba(31, 41, 55, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .service-card.active {
    background: rgba(31, 41, 55, 0.65);
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.1), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .service-card:hover .card-glow {
    opacity: 1;
  }

  .service-card:hover {
    transform: translateY(-5px);
    background: rgba(31, 41, 55, 0.7);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.35);
  }

  .card-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .service-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-light);
    transition: all 0.3s ease;
  }

  .service-card:hover .service-icon {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
  }

  .service-tag {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .service-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
    letter-spacing: -0.2px;
  }

  .service-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .service-features {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-features li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .feat-check {
    width: 16px;
    height: 16px;
    color: var(--accent-blue);
    flex-shrink: 0;
  }

  /* Responsive styling */
  @media (max-width: 1200px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .service-card {
      padding: 1.75rem;
    }
  }
</style>
