---
// ContactForm.astro
---
<section id="contact" class="contact-section">
  <div class="contact-container">
    <div class="contact-grid">
      <!-- Contact Info -->
      <div class="contact-info">
        <div class="section-label">
          <span class="label-text">CONTACT US</span>
        </div>
        <h2 class="section-title">Start a Conversation</h2>
        <p class="contact-desc">
          Based in Toledo, Ohio, we focus on small business online growth and digital security. Have a project in mind, need a security audit, or looking for IT support? Reach out via our form or email us directly.
        </p>

        <div class="contact-channels">
          <!-- Direct Email -->
          <div class="channel-item">
            <div class="channel-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="channel-details">
              <span class="channel-lbl">DIRECT EMAIL</span>
              <button id="copy-email-btn" class="channel-val copy-email-btn" type="button" data-email="3lectricpenguin@gmail.com" aria-label="Copy email address">
                <span class="email-text">3lectricpenguin@gmail.com</span>
                <span class="copy-icon-wrapper">
                  <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="copy-tooltip">Copy email</span>
              </button>
            </div>
          </div>

          <!-- Response Time -->
          <div class="channel-item">
            <div class="channel-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="channel-details">
              <span class="channel-lbl">RESPONSE TIME</span>
              <span class="channel-val">Usually within 24 hours</span>
            </div>
          </div>

          <!-- Service Coverage -->
          <div class="channel-item">
            <div class="channel-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="channel-details">
              <span class="channel-lbl">LOCATION &amp; COVERAGE</span>
              <span class="channel-val">Toledo, OH • Remote &amp; On-Site Support</span>
            </div>
          </div>
        </div>

        <!-- Privacy Box -->
        <div class="privacy-box">
          <div class="privacy-header">
            <span class="privacy-dot"></span>
            <span>PRIVACY &amp; CONFIDENTIALITY</span>
          </div>
          <p class="privacy-text">
            Your privacy is strictly respected. All project inquiries and messages remain confidential.
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-container">
        <form class="secure-form" id="secure-contact-form" action="https://formsubmit.co/3lectricpenguin@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="New Contact Inquiry - Electric Penguin IT Security" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          
          <div class="form-row split">
            <div class="form-group">
              <label for="form-name">YOUR NAME / COMPANY</label>
              <input type="text" id="form-name" name="name" placeholder="John Doe or Local Business LLC" required />
            </div>
            <div class="form-group">
              <label for="form-email">YOUR EMAIL ADDRESS</label>
              <input type="email" id="form-email" name="email" placeholder="you@domain.com" required />
            </div>
          </div>

          <div class="form-group">
            <label for="form-protocol">HOW CAN WE HELP YOU?</label>
            <select id="form-protocol" name="service" required>
              <option value="" disabled selected>Select a service...</option>
              <option value="Web Design & Development">Custom Web Design &amp; Development</option>
              <option value="Website & Data Security Audit">Website &amp; Data Security Audit</option>
              <option value="IT Support & Infrastructure">IT Support &amp; Infrastructure</option>
              <option value="General Inquiry">General Inquiry</option>
            </select>
          </div>

          <div class="form-group">
            <label for="form-message">PROJECT DETAILS / MESSAGE</label>
            <textarea id="form-message" name="message" rows="5" placeholder="Tell us about your project, goals, or what technical help you need..." required></textarea>
          </div>

          <button type="submit" class="btn-submit">
            <span class="btn-text">SEND MESSAGE</span>
            <svg class="submit-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
          
          <div class="form-feedback" id="form-feedback-message"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('secure-contact-form');
  const feedback = document.getElementById('form-feedback-message');
  
  if (form && feedback) {
    const submitBtn = form.querySelector('.btn-submit') as HTMLButtonElement;
    const btnText = submitBtn?.querySelector('.btn-text');
    const originalBtnText = btnText ? btnText.textContent : 'SEND MESSAGE';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const emailInput = document.getElementById('form-email') as HTMLInputElement;
      const email = emailInput ? emailInput.value.trim() : '';
      
      // Clean email validation
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        feedback.style.display = 'block';
        feedback.style.opacity = '1';
        feedback.className = 'form-feedback error';
        feedback.innerHTML = '❌ Please enter a valid email address.';
        return;
      }

      // Show sending state
      if (submitBtn && btnText) {
        submitBtn.disabled = true;
        btnText.textContent = 'SENDING MESSAGE...';
      }
      feedback.style.display = 'block';
      feedback.style.opacity = '1';
      feedback.className = 'form-feedback success';
      feedback.innerHTML = 'Sending your message...';

      const nameInput = document.getElementById('form-name') as HTMLInputElement;
      const protocolInput = document.getElementById('form-protocol') as HTMLSelectElement;
      const messageInput = document.getElementById('form-message') as HTMLTextAreaElement;

      // Direct FormSubmit fetch API
      fetch('https://formsubmit.co/ajax/3lectricpenguin@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          name: nameInput ? nameInput.value.trim() : '',
          email: email,
          service: protocolInput ? protocolInput.value : '',
          message: messageInput ? messageInput.value.trim() : '',
          _subject: 'New Contact Inquiry - Electric Penguin IT Security'
        })
      })
      .then((res) => {
        if (!res.ok) throw new Error('Response error');
        return res.json();
      })
      .then(() => {
        feedback.className = 'form-feedback success';
        feedback.innerHTML = '✔ Message sent successfully! We will get back to you shortly.';
        (form as HTMLFormElement).reset();
        
        setTimeout(() => {
          feedback.style.opacity = '0';
          setTimeout(() => {
            feedback.style.display = 'none';
            feedback.style.opacity = '1';
          }, 500);
        }, 5000);
      })
      .catch((error) => {
        console.error('Submission error:', error);
        feedback.className = 'form-feedback error';
        feedback.innerHTML = '❌ An error occurred. Please try again or email us directly.';
      })
      .finally(() => {
        if (submitBtn && btnText) {
          submitBtn.disabled = false;
          btnText.textContent = originalBtnText;
        }
      });
    });
  }

  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn) {
    const emailText = copyBtn.getAttribute('data-email') || '3lectricpenguin@gmail.com';
    const copyIcon = copyBtn.querySelector('.copy-icon') as HTMLElement;
    const checkIcon = copyBtn.querySelector('.check-icon') as HTMLElement;
    const tooltip = copyBtn.querySelector('.copy-tooltip') as HTMLElement;

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(emailText).then(() => {
        if (tooltip) tooltip.textContent = 'Copied!';
        copyBtn.classList.add('copied');
        if (copyIcon) copyIcon.style.display = 'none';
        if (checkIcon) checkIcon.style.display = 'inline';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (tooltip) tooltip.textContent = 'Copy email';
          if (copyIcon) copyIcon.style.display = 'inline';
          if (checkIcon) checkIcon.style.display = 'none';
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy email: ', err);
      });
    });
  }
</script>

<style>
  .contact-section {
    position: relative;
    padding: 6rem 2rem;
    background-color: var(--bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .contact-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
  }

  .section-label {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .label-text {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-light);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
  }

  .contact-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .channel-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-light);
    flex-shrink: 0;
  }

  .channel-details {
    display: flex;
    flex-direction: column;
  }

  .channel-lbl {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .channel-val {
    font-size: 0.95rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  /* Copy Email Button Styling */
  .copy-email-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--text-primary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    transition: color 0.25s;
    text-align: left;
  }

  .copy-email-btn:hover {
    color: var(--accent-light);
  }

  .copy-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  .copy-email-btn:hover .copy-icon-wrapper {
    color: var(--accent-light);
  }

  .copy-tooltip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-tertiary);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-family: var(--font-display);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .copy-email-btn:hover .copy-tooltip {
    opacity: 1;
  }

  /* Privacy Box Styling */
  .privacy-box {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 1.25rem;
    max-width: 380px;
  }

  .privacy-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-light);
    letter-spacing: 0.5px;
    margin-bottom: 0.4rem;
  }

  .privacy-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-blue);
  }

  .privacy-text {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Contact Form Container */
  .contact-form-container {
    background: rgba(31, 41, 55, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  .secure-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: flex;
    gap: 1.25rem;
  }

  .form-row.split .form-group {
    flex: 1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .form-group select {
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg fill='white' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/><path d='M0 0h24v24H0z' fill='none'/></svg>");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1.25rem;
    padding-right: 2.5rem;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-muted);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  }

  /* Submit Button */
  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.95rem 2rem;
    background: var(--accent-blue);
    border: 1px solid var(--accent-blue);
    border-radius: 6px;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btn-submit:hover {
    background: #2563eb;
    border-color: #2563eb;
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.35);
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .submit-arrow {
    transition: transform 0.25s ease;
  }

  .btn-submit:hover .submit-arrow {
    transform: translateX(3px);
  }

  /* Feedback box */
  .form-feedback {
    display: none;
    padding: 0.85rem;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .form-feedback.success {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
  }

  .form-feedback.error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 576px) {
    .contact-section {
      padding: 4rem 1.25rem;
    }

    .contact-form-container {
      padding: 1.5rem 1.25rem;
    }

    .section-title {
      font-size: 1.85rem;
    }

    .form-row.split {
      flex-direction: column;
      gap: 1.5rem;
    }

    .btn-submit {
      width: 100%;
    }
  }
</style>
